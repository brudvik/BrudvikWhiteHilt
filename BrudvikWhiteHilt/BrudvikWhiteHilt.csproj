<Project>

  <!--
    The SDK is imported by hand rather than with <Project Sdk="...">, so SolutionDir can be set first: Jotunn's props
    (imported with the package, inside Sdk.props) read Environment.props and DoPrebuild.props from it, also when the
    project is built on its own, outside the solution.
  -->
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</SolutionDir>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <RootNamespace>BrudvikWhiteHilt</RootNamespace>
    <AssemblyName>BrudvikWhiteHilt</AssemblyName>
    <!-- Properties\AssemblyInfo.cs holds the version, which publish.ps1 and the release read. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- bin\Debug and bin\Release, as before: publish.ps1 and the tests look there. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <StartAction>Program</StartAction>
    <StartProgram>$(VALHEIM_INSTALL)\valheim.exe</StartProgram>
    <StartArguments>-console</StartArguments>
    <StartWorkingDirectory>$(VALHEIM_INSTALL)</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package for its props, which add the publicized Valheim assemblies and Unity's; Jotunn.dll itself as a
         plain reference, as with packages.config, so what it needs (Unity's netstandard 2.1, MonoMod, Newtonsoft) is
         copied next to the mod too: the tests load the mod from there. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <Reference Include="Jotunn">
      <HintPath>$(PkgJotunnLib)\lib\net462\Jotunn.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>E:\Valheim\Modding\BepInExPack_Valheim\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>E:\Valheim\Modding\BepInExPack_Valheim\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\AssetSource\Ships\sailing_ship.assets.json" LogicalName="BrudvikWhiteHilt.Skidbladnir.assets.json" Link="Pieces\Ships\Skidbladnir\sailing_ship.assets.json" />
    <EmbeddedResource Include="..\AssetSource\Preview\defenses.json" LogicalName="BrudvikWhiteHilt.Defenses.json" Link="Pieces\Defenses\defenses.json" />
    <EmbeddedResource Include="Translations\Norwegian.json" />
    <EmbeddedResource Include="Chests\Translations\English.json" />
    <EmbeddedResource Include="Chests\Translations\Norwegian.json" />
    <EmbeddedResource Include="Assets\GiftOfFreya.png;Assets\GiftOfLoki.png;Assets\GiftOfOdin.png;Assets\GiftOfHugin.png;Assets\GiftOfMunin.png;Assets\GiftOfBaldur.png;Assets\GiftOfBrokkr.png;Assets\GiftOfFenrir.png;Assets\GiftOfFreyr.png;Assets\GiftOfHel.png;Assets\GiftOfNjord.png;Assets\GiftOfRatatoskr.png;Assets\GiftOfSkadi.png;Assets\GiftOfSleipnir.png;Assets\GiftOfSurt.png;Assets\GiftOfThor.png;Assets\GiftOfTyr.png;Assets\GiftOfIdunn.png" CopyToOutputDirectory="Always" />
    <!-- Licensed chest icons, git-ignored; a wildcard so builds without them still work. -->
    <EmbeddedResource Include="Assets\strg_*.png" />
    <EmbeddedResource Include="Assets\WeatherAsh.png" />
    <EmbeddedResource Include="Assets\Logo\WhiteHiltLogo.png" />
    <EmbeddedResource Include="Assets\Compass\CompassDial.png" />
    <EmbeddedResource Include="Assets\Compass\CompassNeedle.png" />
    <EmbeddedResource Include="Assets\Uniform\CapeTrim.png" />
    <EmbeddedResource Include="Assets\PortalFx\RuneRing.png" />
    <EmbeddedResource Include="Assets\PortalFx\Spark.png" />
    <EmbeddedResource Include="Assets\WeatherCloud.png;Assets\WeatherFog.png;Assets\WeatherMoon.png;Assets\WeatherRain.png;Assets\WeatherSnow.png;Assets\WeatherStorm.png;Assets\WeatherSun.png" />
    <EmbeddedResource Include="Assets\whitehilt_foraging" />
    <EmbeddedResource Include="Assets\PortalFx\Depart.wav" />
    <EmbeddedResource Include="Assets\PortalFx\Arrive.wav" />
  </ItemGroup>

  <PropertyGroup>
    <VALHEIM_MANAGED>$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <UNITY_FOLDER>$(SolutionDir)BrudvikStackedChestUnity</UNITY_FOLDER>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="CopyToUnity">
    <Message Text="Copy To Unity" Importance="high" />
    <Copy SourceFiles="$(VALHEIM_INSTALL)/BepInEx/core/BepInEx.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_INSTALL)/BepInEx/core/0Harmony.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_INSTALL)/BepInEx/core/Mono.Cecil.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_INSTALL)/BepInEx/core/MonoMod.Utils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_INSTALL)/BepInEx/core/MonoMod.RuntimeDetour.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)Jotunn.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll.mdb" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_valheim.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_utils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_postprocessing.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_sunshafts.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_guiutils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/assembly_googleanalytics.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/PlayFab.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/PlayFabParty.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/PlatformTools.Core.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/PlatformTools.Common.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/ConnectedStorage.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/gui_framework.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/com.rlabrecque.steamworks.net.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(VALHEIM_MANAGED)/SoftReferenceableAssets.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
  </Target>

  <!-- After every build: publish.ps1 deploys a Debug build to the r2modman profile and packs a Release build. -->
  <Target Name="JotunnPostBuildTaskWin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -ExecutionPolicy RemoteSigned -File &quot;$(SolutionDir)publish.ps1&quot; -Target &quot;$(Configuration)&quot; -TargetPath &quot;$(TargetDir.TrimEnd('\'))&quot; -TargetAssembly &quot;$(TargetFileName)&quot; -ValheimPath &quot;$(VALHEIM_INSTALL.TrimEnd('\'))&quot; -DeployPath &quot;$(MOD_DEPLOYPATH.TrimEnd('\'))&quot; -ProjectPath &quot;$(ProjectDir.TrimEnd('\'))&quot; " />
    <CallTarget Targets="CopyToUnity" Condition="Exists('$(UNITY_FOLDER)')" />
  </Target>

</Project>
