# Keeps editors and tools writing files the way the repository holds them. Git stores text with LF
# (.gitattributes) and checks it out with CRLF on Windows; shell scripts stay LF everywhere.
root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,xml,csproj,props,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
